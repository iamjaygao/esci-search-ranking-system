      "max_copies_of_a_single_pair": 9,
      "pairs_appearing_more_than_once": 12982,
      "queries_containing_at_least_one_duplicated_pair": 6556,
      "cause_1_products_table_joined_on_product_id_only": {
        "product_ids_present_in_multiple_locales": 11567,
        "code_ref": "evaluation/evaluate_advanced.py:62  pd.merge(df, df_pr, on='product_id')"
      },
      "cause_2_esci_s_table_joined_on_product_id_only": {
        "esci_s_rows": 1661908,
        "esci_s_unique_ids": 1650599,
        "esci_s_duplicate_id_rows": 11309,
        "code_ref": "evaluation/evaluate_advanced.py:42  pd.merge(df_pr, df_esci_s[...], on='product_id')"
      },
      "effect_on_ndcg": "A duplicated (query, product) row is counted twice in both the ranked list and the ideal list, so NDCG@10 is computed over a candidate set that does not match the ESCI judgment set. Affected queries get a distorted (usually inflated, because duplicated relevant items fill adjacent top-10 slots) score."
    },
